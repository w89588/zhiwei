# Generate .env with: python tools/init_server_env.py
# For external databases, edit all three WECHAT_* URLs below.
WECHAT_PLATFORM_VERSION=2
WECHAT_DATABASE_URL=mysql+pymysql://wechat:CHANGE_MYSQL_PASSWORD@mysql:3306/wechat?charset=utf8mb4
WECHAT_MONGO_URL=mongodb://wechat:CHANGE_MONGO_PASSWORD@mongodb:27017/wechat?authSource=admin
WECHAT_REDIS_URL=redis://:CHANGE_REDIS_PASSWORD@redis:6379/0
WECHAT_MASTER_KEY=CHANGE_MASTER_KEY
WECHAT_ADMIN_USER=admin
WECHAT_ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
WECHAT_ALLOWED_HOSTS=127.0.0.1,localhost
WECHAT_STARTUP_TIMEOUT=60
WECHAT_MIGRATION_LOCK_TIMEOUT=60
WECHAT_HTTP_PORT=8787
WECHAT_IMAGE=wechat-helper-server:1.0.0

# Used only by the bundled Docker Compose database services.
MYSQL_DATABASE=wechat
MYSQL_USER=wechat
MYSQL_PASSWORD=CHANGE_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_MYSQL_ROOT_PASSWORD
MONGO_INITDB_ROOT_USERNAME=wechat
MONGO_INITDB_ROOT_PASSWORD=CHANGE_MONGO_PASSWORD
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD
